QWidget {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #172033;
    background: #eef2f6;
}

QLabel {
    background: transparent;
}

QMainWindow, QStackedWidget {
    background: #eef2f6;
}

QFrame#Sidebar {
    background: #111827;
    border: none;
    border-right: 1px solid #d7dee8;
}

QFrame#Sidebar QLabel,
QFrame#Sidebar QComboBox {
    background: transparent;
}

QFrame#SidebarBrand {
    background: #0f172a;
    border: 1px solid #293548;
    border-radius: 6px;
}

QLabel#AppTitle {
    color: #ffffff;
    font-size: 21px;
    font-weight: 700;
}

QLabel#AppSubtitle {
    color: #aebbd0;
    font-size: 12px;
    line-height: 18px;
}

QLabel#AppBadge {
    color: #b7f7e8;
    background: #113a3d;
    border: 1px solid #1b8a80;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#SidebarSectionLabel {
    color: #8fa1ba;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0;
    padding: 14px 4px 4px 4px;
}

QPushButton#NavButton {
    color: #dbe4f0;
    background: transparent;
    border: 1px solid transparent;
    border-left: 3px solid transparent;
    border-radius: 6px;
    padding: 9px 10px;
    text-align: left;
    font-weight: 650;
}

QPushButton#NavButton:hover {
    background: #1b2638;
    border-color: #334155;
    color: #ffffff;
}

QPushButton#NavButton[active="true"] {
    background: #0f766e;
    border-color: #14b8a6;
    border-left-color: #ccfbf1;
    color: #ffffff;
}

QFrame#SidebarSummary {
    background: #172235;
    border: 1px solid #314158;
    border-radius: 7px;
}

QLabel#SidebarSummaryTitle {
    color: #d8e2f0;
    font-size: 12px;
    font-weight: 800;
}

QLabel#SidebarSummaryValue {
    color: #9fb0c7;
    font-size: 11px;
    line-height: 16px;
}

QLabel#SidebarStatusPill {
    color: #b7f7e8;
    background: #0f3a3a;
    border: 1px solid #1f8b82;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 10px;
    font-weight: 800;
}

QLabel#SidebarStat {
    color: #b8c6da;
    background: #101827;
    border: 1px solid #2b3a50;
    border-radius: 5px;
    padding: 5px 4px;
    font-size: 10px;
    line-height: 15px;
}

QLabel#SidebarStat b {
    color: #ffffff;
    font-size: 14px;
}

QPushButton#SidebarLicenseButton {
    color: #0f172a;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    padding: 8px 10px;
    font-weight: 800;
}

QPushButton#SidebarLicenseButton:hover {
    color: #0f766e;
    background: #ecfdf8;
    border-color: #55bdb2;
}

QLabel#SidebarFieldLabel {
    color: #8fa1ba;
    font-size: 10px;
    font-weight: 800;
    padding-top: 2px;
}

QComboBox#SidebarLanguage {
    color: #e4ebf5;
    background: #111827;
    border: 1px solid #344255;
    border-radius: 5px;
    padding: 6px 34px 6px 10px;
}

QComboBox#SidebarLanguage::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 30px;
    border-left: 1px solid #344255;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    background: #1d293b;
}

QComboBox#SidebarLanguage::down-arrow {
    image: url(:/icons/ui/chevron-down-light.png);
    width: 16px;
    height: 16px;
}

QComboBox#SidebarLanguage QAbstractItemView {
    color: #e4ebf5;
    background: #182235;
    border: 1px solid #344255;
    selection-background-color: #0f766e;
    selection-color: #ffffff;
}

QWidget#PageHeader {
    background: transparent;
}

QLabel#PageTitle {
    font-size: 23px;
    font-weight: 750;
    color: #101828;
    background: transparent;
}

QLabel#PageSubtitle {
    color: #5d6b82;
    font-size: 12px;
    background: transparent;
}

QLabel#SectionTitle {
    font-size: 15px;
    font-weight: 750;
    color: #142033;
    background: transparent;
}

QFrame#SectionCard,
QFrame#MetricCard,
QFrame#PlanCard {
    background: #ffffff;
    border: 1px solid #d8e0ea;
    border-radius: 6px;
}

QFrame#FilterPanel {
    background: #ffffff;
    border: 1px solid #d5dde8;
    border-radius: 6px;
}

QLabel#FilterPanelTitle {
    color: #101828;
    font-size: 16px;
    font-weight: 800;
    background: transparent;
}

QLabel#FilterPanelSubtitle,
QLabel#FilterHint {
    color: #667085;
    font-size: 12px;
    background: transparent;
}

QFrame#FilterGroup {
    background: #f8fafc;
    border: 1px solid #e1e7ef;
    border-radius: 6px;
}

QLabel#FilterGroupTitle {
    color: #0f766e;
    font-size: 12px;
    font-weight: 800;
    background: transparent;
}

QWidget#FilterField,
QWidget#FilterHeaderText,
QWidget#FilterCheckGroup {
    background: transparent;
}

QLabel#FilterFieldLabel {
    color: #475467;
    font-size: 11px;
    font-weight: 800;
    background: transparent;
}

QFrame#FilterPanel QComboBox,
QFrame#FilterPanel QSpinBox,
QFrame#FilterPanel QDoubleSpinBox {
    background: #ffffff;
}

QFrame#FilterPanel QPushButton {
    min-width: 128px;
}

QScrollArea#ParameterScroll {
    background: transparent;
    border: none;
}

QWidget#ParameterInputPanel,
QWidget#ParameterField,
QWidget#CalculationResultHeader {
    background: transparent;
}

QFrame#ParameterGroup,
QFrame#CalculationResultPanel {
    background: #ffffff;
    border: 1px solid #d8e0ea;
    border-radius: 6px;
}

QLabel#ParameterGroupTitle,
QLabel#CalculationResultTitle {
    color: #101828;
    font-size: 15px;
    font-weight: 800;
    background: transparent;
}

QLabel#ParameterGroupSubtitle,
QLabel#CalculationResultSubtitle {
    color: #667085;
    font-size: 12px;
    background: transparent;
}

QLabel#ParameterFieldLabel {
    color: #475467;
    font-size: 11px;
    font-weight: 800;
    background: transparent;
}

QFrame#ParameterGroup QComboBox,
QFrame#ParameterGroup QSpinBox,
QFrame#ParameterGroup QDoubleSpinBox {
    background: #ffffff;
}

QTextEdit#CalculationResultText {
    background: #fbfcfe;
    border: 1px solid #e1e7ef;
    border-radius: 6px;
}

QFrame#CalculationResultPanel QPushButton {
    min-width: 112px;
}

QFrame#PlanCard[state="good"] {
    border-color: #8bd8bd;
}

QFrame#PlanCard[state="bad"] {
    border-color: #f2a5a5;
}

QFrame#MetricCard[state="good"] {
    border-color: #8bd8bd;
    background: #f2fbf7;
}

QFrame#MetricCard[state="warn"] {
    border-color: #f2cf88;
    background: #fff8eb;
}

QFrame#MetricCard[state="bad"] {
    border-color: #f2a5a5;
    background: #fff4f4;
}

QLabel#MetricLabel {
    color: #667085;
    font-size: 11px;
    font-weight: 800;
    background: transparent;
}

QLabel#MetricValue {
    color: #111827;
    font-size: 18px;
    font-weight: 800;
    background: transparent;
}

QLabel#MetricDetail {
    color: #667085;
    font-size: 12px;
    background: transparent;
}

QLabel#StatusBadge {
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 800;
    color: #344054;
    background: #e5eaf1;
}

QLabel#StatusBadge[state="good"] {
    color: #05603a;
    background: #dff8eb;
}

QLabel#StatusBadge[state="warn"] {
    color: #8a4b00;
    background: #fff1c7;
}

QLabel#StatusBadge[state="bad"] {
    color: #b42318;
    background: #fee4e2;
}

QLabel#StatusBadge[state="info"] {
    color: #174ea6;
    background: #dbeafe;
}

QGroupBox {
    border: 1px solid #d8e0ea;
    border-radius: 6px;
    margin-top: 18px;
    padding: 14px 12px 12px 12px;
    background: #fbfcfe;
    font-weight: 750;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    top: 1px;
    padding: 2px 8px;
    color: #334155;
    background: #eef2f6;
    border-radius: 4px;
}

QGroupBox QLabel {
    color: #48576b;
    background: transparent;
    font-weight: 500;
}

QGroupBox QCheckBox {
    font-weight: 500;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit, QTextBrowser, QPlainTextEdit {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    padding: 7px 9px;
    min-height: 20px;
    selection-background-color: #0f766e;
    selection-color: #ffffff;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus,
QTextEdit:focus, QTextBrowser:focus, QPlainTextEdit:focus {
    border: 1px solid #0f766e;
}

QComboBox {
    padding: 7px 36px 7px 10px;
}

QComboBox:hover {
    border-color: #94c9c4;
}

QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 32px;
    border-left: 1px solid #d8e0ea;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    background: #f8fafc;
}

QComboBox:hover::drop-down {
    background: #eef8f6;
    border-left-color: #b6deda;
}

QComboBox:focus::drop-down {
    background: #ecfdf8;
    border-left-color: #0f766e;
}

QComboBox::down-arrow {
    image: url(:/icons/ui/chevron-down.png);
    width: 16px;
    height: 16px;
}

QComboBox:disabled {
    color: #98a2b3;
    background: #f3f6fa;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    color: #172033;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    padding: 4px;
    outline: 0;
    selection-background-color: #d8f3ee;
    selection-color: #101828;
}

QSpinBox, QDoubleSpinBox {
    padding: 5px 26px 5px 10px;
    min-height: 18px;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #94c9c4;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 22px;
    margin: 1px 1px 0 0;
    border-left: 1px solid #e3e8ef;
    border-bottom: 1px solid #e3e8ef;
    border-top-right-radius: 5px;
    background: #fbfdff;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 22px;
    margin: 0 1px 1px 0;
    border-left: 1px solid #e3e8ef;
    border-bottom-right-radius: 5px;
    background: #fbfdff;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: #eef8f6;
    border-left-color: #b6deda;
}

QSpinBox:focus::up-button, QDoubleSpinBox:focus::up-button,
QSpinBox:focus::down-button, QDoubleSpinBox:focus::down-button {
    border-left-color: #0f766e;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(:/icons/ui/chevron-up.png);
    width: 9px;
    height: 9px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(:/icons/ui/chevron-down.png);
    width: 9px;
    height: 9px;
}

QSpinBox:disabled, QDoubleSpinBox:disabled {
    color: #98a2b3;
    background: #f3f6fa;
}

QCheckBox {
    background: transparent;
    spacing: 8px;
    color: #344054;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border: 1px solid #aeb8c6;
    background: #ffffff;
}

QCheckBox::indicator:checked {
    background: #0f766e;
    border: 1px solid #0f766e;
}

QPushButton,
QPushButton#PrimaryButton {
    background: #0f766e;
    color: #ffffff;
    border: 1px solid #0f766e;
    border-radius: 5px;
    padding: 8px 13px;
    font-weight: 750;
}

QPushButton:hover,
QPushButton#PrimaryButton:hover {
    background: #0b615a;
    border-color: #0b615a;
}

QPushButton:disabled {
    background: #c7d0dd;
    border-color: #c7d0dd;
    color: #ffffff;
}

QPushButton#SecondaryButton {
    color: #344054;
    background: #ffffff;
    border: 1px solid #cbd5e1;
}

QPushButton#SecondaryButton:hover {
    color: #0f766e;
    background: #f6faf9;
    border-color: #94c9c4;
}

QTableWidget {
    background: #ffffff;
    alternate-background-color: #f7f9fc;
    border: 1px solid #d8e0ea;
    border-radius: 6px;
    gridline-color: #e6ebf2;
    selection-background-color: #d8f3ee;
    selection-color: #101828;
}

QHeaderView::section {
    background: #edf2f7;
    color: #344054;
    border: none;
    border-right: 1px solid #d8e0ea;
    border-bottom: 1px solid #d8e0ea;
    padding: 8px;
    font-weight: 800;
}

QTabWidget::pane {
    border: 1px solid #d8e0ea;
    border-radius: 6px;
    top: -1px;
    background: #ffffff;
}

QTabBar::tab {
    background: #e6ebf2;
    color: #536174;
    padding: 9px 16px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    margin-right: 2px;
    font-weight: 700;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #0f766e;
}

QSplitter::handle {
    background: #d8e0ea;
}

QScrollBar:vertical {
    background: #edf2f7;
    border: 1px solid #dce3ec;
    border-radius: 5px;
    width: 11px;
    margin: 2px;
}

QScrollBar:horizontal {
    background: #edf2f7;
    border: 1px solid #dce3ec;
    border-radius: 5px;
    height: 11px;
    margin: 2px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: #94a3b8;
    border: 1px solid #8797ac;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    min-height: 38px;
}

QScrollBar::handle:horizontal {
    min-width: 38px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #64748b;
    border-color: #58677a;
}

QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:pressed {
    background: #0f766e;
    border-color: #0f766e;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
    background: transparent;
    border: none;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: none;
}

QSlider {
    background: transparent;
}

QSlider::groove:horizontal {
    background: #dbe3ee;
    border: 1px solid #ccd6e3;
    border-radius: 4px;
    height: 8px;
}

QSlider::groove:vertical {
    background: #dbe3ee;
    border: 1px solid #ccd6e3;
    border-radius: 4px;
    width: 8px;
}

QSlider::sub-page:horizontal,
QSlider::add-page:vertical {
    background: #0f766e;
    border: 1px solid #0f766e;
    border-radius: 4px;
}

QSlider::add-page:horizontal,
QSlider::sub-page:vertical {
    background: #dbe3ee;
    border: 1px solid #ccd6e3;
    border-radius: 4px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 2px solid #0f766e;
    border-radius: 8px;
    width: 16px;
    height: 16px;
    margin: -5px 0;
}

QSlider::handle:vertical {
    background: #ffffff;
    border: 2px solid #0f766e;
    border-radius: 8px;
    width: 16px;
    height: 16px;
    margin: 0 -5px;
}

QSlider::handle:horizontal:hover,
QSlider::handle:vertical:hover {
    background: #ecfdf8;
    border-color: #0b615a;
}

QSlider::handle:horizontal:pressed,
QSlider::handle:vertical:pressed {
    background: #0f766e;
    border-color: #0f766e;
}

QSlider:disabled::groove:horizontal,
QSlider:disabled::groove:vertical,
QSlider:disabled::add-page:horizontal,
QSlider:disabled::sub-page:horizontal,
QSlider:disabled::add-page:vertical,
QSlider:disabled::sub-page:vertical {
    background: #e5eaf1;
    border-color: #d7dee8;
}

QSlider:disabled::handle:horizontal,
QSlider:disabled::handle:vertical {
    background: #f3f6fa;
    border-color: #b9c4d2;
}

/* Engineering Control Console */
QWidget {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #18263a;
    background: #f4f6f8;
}

QLabel {
    background: transparent;
}

QMainWindow {
    background: transparent;
}

QMainWindow, QWidget#ApplicationShell, QWidget#ShellWorkspace, QStackedWidget {
    background: #f4f6f8;
}

QWidget#ApplicationShell {
    border-radius: 12px;
}

QFrame#ShellTopBar {
    background: #121b27;
    border: none;
    border-bottom: 1px solid #2f3c4b;
}

QToolButton#WindowControlButton,
QToolButton#WindowCloseButton {
    color: #c3cfdb;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
    min-width: 32px;
    min-height: 28px;
    padding: 0;
    font-family: "Segoe UI", sans-serif;
    font-size: 16px;
    font-weight: 400;
}

QToolButton#WindowControlButton:hover {
    color: #ffffff;
    background: #263849;
    border-color: #3f5265;
}

QToolButton#WindowCloseButton:hover {
    color: #ffffff;
    background: #c44747;
    border-color: #d15b5b;
}

QLabel#TopBarIcon {
    background: transparent;
}

QLabel#TopBarBrand {
    color: #ffffff;
    font-size: 17px;
    font-weight: 800;
}

QLabel#TopBarProduct {
    color: #b8c4d2;
    font-size: 12px;
    padding-right: 10px;
}

QLabel#TopBarPage {
    color: #dbe7f4;
    font-size: 12px;
    font-weight: 700;
    border-left: 1px solid #3b4858;
    padding-left: 14px;
}

QLabel#WorkflowStep {
    color: #7f8b9a;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#WorkflowStep[state="done"] {
    color: #8fb8e8;
}

QLabel#WorkflowStep[state="active"] {
    color: #ffffff;
    background: #176fd1;
    border-color: #2e86e6;
}

QFrame#Sidebar {
    background: #202e3b;
    border: none;
    border-right: 1px solid #394958;
}

QLabel#RailMark {
    background: transparent;
    border-bottom: 1px solid #3b4a59;
    padding-bottom: 8px;
}

QLabel#SidebarSectionLabel {
    color: #8291a0;
    background: transparent;
    font-size: 9px;
    font-weight: 800;
    padding: 7px 2px 1px 2px;
    text-align: center;
}

QPushButton#NavButton {
    color: #d9e2eb;
    background: transparent;
    border: 1px solid transparent;
    border-left: 3px solid transparent;
    border-radius: 2px;
    padding: 7px 5px;
    text-align: left;
    font-size: 11px;
    font-weight: 700;
}

QPushButton#NavButton:hover {
    color: #ffffff;
    background: #2b3d4d;
    border-color: #405466;
}

QPushButton#NavButton[active="true"] {
    color: #ffffff;
    background: #176fd1;
    border-color: #2d83df;
    border-left-color: #8fc7ff;
}

QPushButton#SidebarLicenseButton {
    color: #dce7f1;
    background: #263746;
    border: 1px solid #435565;
    border-radius: 2px;
    padding: 7px 5px;
    font-size: 11px;
}

QPushButton#SidebarLicenseButton:hover {
    color: #ffffff;
    background: #31495d;
    border-color: #62829d;
}

QComboBox#SidebarLanguage {
    color: #dce7f1;
    background: #1a2733;
    border: 1px solid #435565;
    border-radius: 2px;
    padding: 6px 24px 6px 6px;
    font-size: 11px;
}

QComboBox#SidebarLanguage::drop-down {
    width: 22px;
    background: #263746;
    border-left: 1px solid #435565;
}

QFrame#ShellStatusBar {
    background: #ffffff;
    border: none;
    border-top: 1px solid #cbd4df;
}

QLabel#ShellStatusPill {
    color: #116648;
    background: #e5f6ef;
    border: 1px solid #a8d8c7;
    border-radius: 2px;
    padding: 3px 8px;
    font-size: 10px;
    font-weight: 800;
}

QLabel#ShellStatusPill[state="busy"] {
    color: #174f91;
    background: #e7f1fd;
    border-color: #aac9eb;
}

QLabel#ShellStatusText, QLabel#ShellCatalogStat, QLabel#ShellUnits {
    color: #526173;
    background: transparent;
    font-size: 10px;
}

QLabel#ShellCatalogStat {
    color: #263b51;
    border-left: 1px solid #d8dee6;
    padding-left: 10px;
    font-weight: 700;
}

QFrame#RequirementOutline {
    background: #ffffff;
    border: none;
    border-right: 1px solid #cbd4df;
}

QFrame#RequirementEditor {
    background: #f7f8fa;
    border: none;
}

QFrame#ConstraintInspector {
    background: #ffffff;
    border: none;
    border-left: 1px solid #cbd4df;
}

QLabel#PaneTitle {
    color: #172335;
    background: transparent;
    font-size: 18px;
    font-weight: 800;
}

QLabel#PaneSubtitle {
    color: #657487;
    background: transparent;
    font-size: 11px;
    line-height: 17px;
}

QFrame#OutlineSection {
    background: #fbfcfd;
    border: 1px solid #dbe2ea;
    border-left: 3px solid #bcc8d5;
    border-radius: 2px;
}

QFrame#OutlineSection[state="active"] {
    background: #edf5ff;
    border-color: #8ab9ec;
    border-left-color: #176fd1;
}

QFrame#OutlineSection[state="warn"] {
    border-left-color: #d38920;
}

QLabel#OutlineSectionTitle {
    color: #23364b;
    font-size: 12px;
    font-weight: 800;
}

QLabel#OutlineSectionStatus {
    color: #16815f;
    font-size: 10px;
    font-weight: 700;
}

QFrame#OutlineSection[state="warn"] QLabel#OutlineSectionStatus {
    color: #b36a0b;
}

QLabel#OutlineSectionDetail {
    color: #667587;
    font-size: 10px;
    line-height: 15px;
}

QLabel#OutlineFieldTitle {
    color: #34465a;
    font-size: 11px;
    font-weight: 800;
}

QScrollArea#RequirementScroll, QWidget#RequirementContent {
    background: transparent;
    border: none;
}

QFrame#EditorGroup {
    background: #ffffff;
    border: 1px solid #d5dde6;
    border-radius: 2px;
}

QLabel#EditorGroupTitle {
    color: #176fd1;
    background: transparent;
    font-size: 13px;
    font-weight: 800;
    border-bottom: 1px solid #e2e7ed;
    padding-bottom: 7px;
}

QLabel#EditorFieldLabel {
    color: #44566a;
    background: transparent;
    font-size: 11px;
    font-weight: 700;
}

QLabel#InspectorSectionTitle {
    color: #273b51;
    background: transparent;
    font-size: 11px;
    font-weight: 800;
    border-bottom: 1px solid #dce3ea;
    padding: 5px 0 6px 0;
}

QFrame#InspectorRow {
    background: #fbfcfd;
    border: 1px solid #e0e5eb;
    border-radius: 1px;
}

QLabel#InspectorLabel {
    color: #58687a;
    font-size: 10px;
}

QLabel#InspectorValue {
    color: #1d3550;
    font-size: 11px;
    font-weight: 800;
}

QLabel#InspectorPass {
    color: #15946d;
    font-size: 10px;
}

QFrame#InspectorRisk {
    background: #fff9ef;
    border: 1px solid #e4ad5e;
    border-radius: 2px;
}

QLabel#InspectorRiskLabel {
    color: #b2680c;
    font-size: 10px;
    font-weight: 800;
}

QLabel#InspectorRiskValue {
    color: #5b4020;
    font-size: 11px;
    font-weight: 700;
    line-height: 17px;
}

QFrame#PageCommandBar {
    background: #ffffff;
    border: none;
    border-top: 1px solid #cbd4df;
}

QLabel#CommandHint {
    color: #607084;
    background: transparent;
    font-size: 11px;
}

QWidget#PageHeader {
    background: transparent;
}

QLabel#PageTitle {
    color: #172335;
    font-size: 20px;
    font-weight: 800;
}

QLabel#PageSubtitle {
    color: #657487;
    font-size: 11px;
}

QFrame#SectionCard, QFrame#MetricCard, QFrame#PlanCard,
QFrame#FilterPanel, QFrame#ParameterGroup, QFrame#CalculationResultPanel {
    background: #ffffff;
    border: 1px solid #d5dde6;
    border-radius: 2px;
}

QFrame#FilterGroup {
    background: #f8fafc;
    border: 1px solid #dce3ea;
    border-radius: 2px;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit, QTextBrowser, QPlainTextEdit {
    color: #1e2d3e;
    background: #ffffff;
    border: 1px solid #bfcad6;
    border-radius: 2px;
    padding: 6px 8px;
    min-height: 18px;
    selection-background-color: #176fd1;
    selection-color: #ffffff;
}

QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover {
    border-color: #6d9ed3;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus,
QTextEdit:focus, QTextBrowser:focus, QPlainTextEdit:focus {
    border: 1px solid #176fd1;
}

QComboBox::drop-down {
    width: 28px;
    background: #f3f6f9;
    border-left: 1px solid #d1d9e2;
    border-radius: 0;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background: #f4f7fa;
    border-left: 1px solid #d7dee6;
    border-radius: 0;
}

QCheckBox {
    color: #34465a;
    spacing: 7px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border-radius: 2px;
    border: 1px solid #9caabc;
    background: #ffffff;
}

QCheckBox::indicator:checked {
    background: #176fd1;
    border-color: #176fd1;
}

QPushButton, QPushButton#PrimaryButton {
    color: #ffffff;
    background: #176fd1;
    border: 1px solid #176fd1;
    border-radius: 2px;
    padding: 7px 12px;
    font-weight: 800;
}

QPushButton:hover, QPushButton#PrimaryButton:hover {
    background: #0f5db5;
    border-color: #0f5db5;
}

QPushButton#SecondaryButton {
    color: #2e4054;
    background: #ffffff;
    border: 1px solid #bfcad6;
}

QPushButton#SecondaryButton:hover {
    color: #155ca8;
    background: #f0f6fc;
    border-color: #6e9dce;
}

QTableWidget {
    color: #26394e;
    background: #ffffff;
    alternate-background-color: #f7f9fb;
    border: 1px solid #cbd4df;
    border-radius: 1px;
    gridline-color: #dce3ea;
    selection-background-color: #dbeafe;
    selection-color: #17314e;
}

QHeaderView::section {
    color: #34475c;
    background: #eef2f6;
    border: none;
    border-right: 1px solid #d4dce5;
    border-bottom: 1px solid #c5d0dc;
    padding: 7px;
    font-size: 11px;
    font-weight: 800;
}

QTabWidget::pane {
    background: #ffffff;
    border: 1px solid #cbd4df;
    border-radius: 1px;
}

QTabBar::tab {
    color: #526376;
    background: #e8edf2;
    border-radius: 0;
    padding: 8px 15px;
    font-weight: 700;
}

QTabBar::tab:selected {
    color: #155fac;
    background: #ffffff;
    border-top: 2px solid #176fd1;
}

QSplitter::handle {
    background: #cbd4df;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #8797a8;
    border-color: #7a8b9c;
    border-radius: 2px;
}

QScrollBar::handle:vertical:pressed, QScrollBar::handle:horizontal:pressed {
    background: #176fd1;
    border-color: #176fd1;
}
