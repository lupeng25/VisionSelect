        <file alias="i18n/visionselect_en_US.qm">i18n/visionselect_en_US.qm</file>
        <file alias="license/public_key.json">license/public_key.json</file>
        <file alias="icons/visionselect_icon_256.png">icons/visionselect_icon_256.png</file>
        <file alias="icons/ui/assistant.png">icons/ui/assistant.png</file>
        <file alias="icons/ui/calculate.png">icons/ui/calculate.png</file>
        <file alias="icons/ui/camera3d.png">icons/ui/camera3d.png</file>
        <file alias="icons/ui/catalog.png">icons/ui/catalog.png</file>
        <file alias="icons/ui/chevron-down-light.png">icons/ui/chevron-down-light.png</file>
        <file alias="icons/ui/chevron-down.png">icons/ui/chevron-down.png</file>
        <file alias="icons/ui/chevron-up-light.png">icons/ui/chevron-up-light.png</file>
        <file alias="icons/ui/chevron-up.png">icons/ui/chevron-up.png</file>
        <file alias="icons/ui/compare.png">icons/ui/compare.png</file>
        <file alias="icons/ui/error.png">icons/ui/error.png</file>
        <file alias="icons/ui/export.png">icons/ui/export.png</file>
        <file alias="icons/ui/info.png">icons/ui/info.png</file>
        <file alias="icons/ui/report.png">icons/ui/report.png</file>
        <file alias="icons/ui/requirement.png">icons/ui/requirement.png</file>
        <file alias="icons/ui/results.png">icons/ui/results.png</file>
        <file alias="icons/ui/success.png">icons/ui/success.png</file>
