{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-mingw64",
      "displayName": "Windows MinGW 64-bit",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-mingw64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}",
        "CMAKE_C_COMPILER": "$env{MINGW_ROOT}/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "$env{MINGW_ROOT}/bin/g++.exe"
      }
    },
    {
      "name": "windows-mingw64-release",
      "displayName": "Windows MinGW 64-bit Release",
      "inherits": "windows-mingw64",
      "binaryDir": "${sourceDir}/build/windows-mingw64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-msvc2022",
      "displayName": "Windows MSVC 2022 x64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-msvc2022",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}",
        "CMAKE_CXX_COMPILER": "cl.exe"
      }
    },
    {
      "name": "windows-msvc2022-release",
      "displayName": "Windows MSVC 2022 x64 Release",
      "inherits": "windows-msvc2022",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-mingw64",
      "configurePreset": "windows-mingw64"
    },
    {
      "name": "windows-mingw64-release",
      "configurePreset": "windows-mingw64-release"
    },
    {
      "name": "windows-msvc2022",
      "configurePreset": "windows-msvc2022"
    },
    {
      "name": "windows-msvc2022-release",
      "configurePreset": "windows-msvc2022-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-mingw64",
      "configurePreset": "windows-mingw64",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-msvc2022",
      "configurePreset": "windows-msvc2022",
      "output": { "outputOnFailure": true }
    }
  ]
}
