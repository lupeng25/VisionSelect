{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VisionSelect",
  "version": "3.0.0",
  "identifier": "com.visionselect.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VisionSelect · 视觉选型工作台",
        "width": 1520,
        "height": 960,
        "minWidth": 1000,
        "minHeight": 720,
        "theme": "Dark",
        "backgroundColor": "#2c3037"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "机器视觉工程选型工作台",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
