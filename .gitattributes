# 项目文本统一使用 UTF-8 与 LF，编辑器设置见 .editorconfig。
* text=auto
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.yml text eol=lf
*.lock text eol=lf