{
  "name": "visionselect",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "dev:api": "cargo run -p vision-server",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests/e2e *.ts *.json .github/workflows/windows.yml",
    "format:check": "prettier --check src tests/e2e *.ts *.json .github/workflows/windows.yml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.0",
    "@tauri-apps/cli": "^2.11.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.0"
  }
}
